# Next.js + Supabase SaaS Template Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Naver Cloud Platform - Maps API (Reverse Geocoding)
# 네이버 클라우드 플랫폼 Maps API의 Reverse Geocoding을 사용하여 GPS 좌표를 주소로 변환합니다.
# API Gateway에서 발급받은 API Key를 사용합니다.
# API 키 발급: https://www.ncloud.com/product/applicationService/maps
# 헤더: x-ncp-apigw-api-key-id, x-ncp-apigw-api-key
NCP_API_GATEWAY_KEY_ID=
NCP_API_GATEWAY_KEY=

# Optional: Sentry Error Monitoring
SENTRY_AUTH_TOKEN=

# Optional: External OAuth Providers
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth (disabled)
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# Optional: Example Integration (remove if not needed)
# Example OAuth Provider
EXAMPLE_CLIENT_ID=
EXAMPLE_CLIENT_SECRET=
EXAMPLE_WEBHOOK_SECRET=

# Optional: Background Jobs
INNGEST_SIGNING_KEY=

# Optional: AI Integration
OPENROUTER_API_KEY=

# Naver Pay Configuration
# 네이버 페이 API 연동을 위한 설정
# 개발자 센터: https://developers.pay.naver.com/
NAVER_PAY_API_URL=https://dev.apis.naver.com
NAVER_PAY_CLIENT_ID=
NAVER_PAY_SECRET_KEY=
NAVER_PAY_WEBHOOK_SECRET=